---
layout: null
---
{%- assign articles = site.data.articles | sort: "published" | reverse -%}
{%- assign latest = articles | first -%}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

  <title>Articoli Coluccini</title>
  <subtitle>raccolta dei vari articoli usciti</subtitle>
  <link href="{{ '/feed' | absolute_url }}" rel="self"/>
  <link href="{{ site.url }}"/>
  <id>urn:uuid:517732cb-5602-4f20-91e6-f318a39cac39</id>
  <updated>{{ latest.published }}</updated>

  <author>
    <name>Riccardo Coluccini</name>
    <email>{{ site.email }}</email>
  </author>
{% for article in articles %}
  <entry>
    <title>{{ article.title | xml_escape }}</title>
    <link href="{{ article.link }}"/>
    <id>{{ article.id }}</id>
    <published>{{ article.published }}</published>
    <updated>{{ article.updated }}</updated>
    <summary>{{ article.summary | xml_escape }}</summary>
  </entry>
{% endfor %}
</feed>
